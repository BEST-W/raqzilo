# Configure secrets in the host; never commit actual credentials.
BOT_TOKEN=
OWNER_TELEGRAM_ID=
PUBLIC_URL=
AUTO_CONFIGURE_WEBHOOK=false
# Must be a PRIVATE PERSISTENT path for accepting real orders.
DATA_DIR=/var/lib/wajha
CHANNEL_USERNAME=
SUPPORT_USERNAME=
PORT=10000

# Enable only after proving hosting storage survives restart/redeploy.
ACCEPT_SERVICE_REQUESTS=false
