# For development, TURSO_DATABASE_URL may be file:local.db.
# Production values are injected by the Turso integration; never commit them.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Private Blob uses Vercel OIDC in deployed functions.
BLOB_STORE_ID=
# Random 64-character hexadecimal, one-use owner activation key.
# Expires is a future Unix timestamp in milliseconds. Remove both after activation.
OWNER_SETUP_TOKEN=
OWNER_SETUP_EXPIRES=
# Optional one-time import from the existing site, before promoting the new deployment.
MIGRATION_TOKEN=
MIGRATION_EXPIRES=
